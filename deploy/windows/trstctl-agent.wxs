<?xml version="1.0" encoding="UTF-8"?>
<!-- Derived from the trstctl winservice generator (internal/agent/winservice);
     the first-boot properties, launch conditions and remembered settings
     below are maintained in this file. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="trstctl agent" Language="1033" Version="0.1.0"
           Manufacturer="trstctl" UpgradeCode="5F1B5E4C-9A2D-4C3E-8B7A-2E6D9C1F0A34">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="trstctl non-human identity agent: enrolls with the control plane, maintains mutual TLS, and installs and rotates credentials on this host." />
    <MajorUpgrade DowngradeErrorMessage="A newer version of trstctl agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <!-- First-boot settings. A repair (msiexec /f) takes no properties from
         its command line, so each setting is remembered in the registry at
         install and read back for maintenance; a value on the command line
         (a fresh install or an upgrade) wins over the remembered one. -->
    <Property Id="ENROLLURL" Secure="yes">
      <RegistrySearch Id="RememberedEnrollUrl" Root="HKLM" Key="Software\trstctl\agent" Name="EnrollUrl" Type="raw" />
    </Property>
    <Property Id="SERVER" Secure="yes">
      <RegistrySearch Id="RememberedServer" Root="HKLM" Key="Software\trstctl\agent" Name="Server" Type="raw" />
    </Property>
    <Property Id="SERVERNAME" Secure="yes">
      <RegistrySearch Id="RememberedServerName" Root="HKLM" Key="Software\trstctl\agent" Name="ServerName" Type="raw" />
    </Property>
    <Property Id="CABUNDLE" Secure="yes">
      <RegistrySearch Id="RememberedCaBundle" Root="HKLM" Key="Software\trstctl\agent" Name="CaBundle" Type="raw" />
    </Property>
    <Property Id="BOOTSTRAPTOKENFILE" Secure="yes">
      <RegistrySearch Id="RememberedBootstrapTokenFile" Root="HKLM" Key="Software\trstctl\agent" Name="BootstrapTokenFile" Type="raw" />
    </Property>
    <CustomAction Id="SaveEnrollUrl" Property="CMDLINE_ENROLLURL" Value="[ENROLLURL]" Execute="firstSequence" />
    <CustomAction Id="RestoreEnrollUrl" Property="ENROLLURL" Value="[CMDLINE_ENROLLURL]" Execute="firstSequence" />
    <CustomAction Id="SaveServer" Property="CMDLINE_SERVER" Value="[SERVER]" Execute="firstSequence" />
    <CustomAction Id="RestoreServer" Property="SERVER" Value="[CMDLINE_SERVER]" Execute="firstSequence" />
    <CustomAction Id="SaveServerName" Property="CMDLINE_SERVERNAME" Value="[SERVERNAME]" Execute="firstSequence" />
    <CustomAction Id="RestoreServerName" Property="SERVERNAME" Value="[CMDLINE_SERVERNAME]" Execute="firstSequence" />
    <CustomAction Id="SaveCaBundle" Property="CMDLINE_CABUNDLE" Value="[CABUNDLE]" Execute="firstSequence" />
    <CustomAction Id="RestoreCaBundle" Property="CABUNDLE" Value="[CMDLINE_CABUNDLE]" Execute="firstSequence" />
    <CustomAction Id="SaveBootstrapTokenFile" Property="CMDLINE_BOOTSTRAPTOKENFILE" Value="[BOOTSTRAPTOKENFILE]" Execute="firstSequence" />
    <CustomAction Id="RestoreBootstrapTokenFile" Property="BOOTSTRAPTOKENFILE" Value="[CMDLINE_BOOTSTRAPTOKENFILE]" Execute="firstSequence" />
    <CustomAction Id="DefaultCaBundle" Property="CABUNDLE" Value="[CommonAppDataFolder]trstctl\ca-bundle.pem" Execute="firstSequence" />
    <CustomAction Id="DefaultBootstrapTokenFile" Property="BOOTSTRAPTOKENFILE" Value="[CommonAppDataFolder]trstctl\bootstrap-token.txt" Execute="firstSequence" />
    <InstallUISequence>
      <Custom Action="SaveEnrollUrl" Before="AppSearch" />
      <Custom Action="RestoreEnrollUrl" After="AppSearch">CMDLINE_ENROLLURL</Custom>
      <Custom Action="SaveServer" Before="AppSearch" />
      <Custom Action="RestoreServer" After="AppSearch">CMDLINE_SERVER</Custom>
      <Custom Action="SaveServerName" Before="AppSearch" />
      <Custom Action="RestoreServerName" After="AppSearch">CMDLINE_SERVERNAME</Custom>
      <Custom Action="SaveCaBundle" Before="AppSearch" />
      <Custom Action="RestoreCaBundle" After="AppSearch">CMDLINE_CABUNDLE</Custom>
      <Custom Action="SaveBootstrapTokenFile" Before="AppSearch" />
      <Custom Action="RestoreBootstrapTokenFile" After="AppSearch">CMDLINE_BOOTSTRAPTOKENFILE</Custom>
      <Custom Action="DefaultCaBundle" After="RestoreCaBundle">NOT CABUNDLE</Custom>
      <Custom Action="DefaultBootstrapTokenFile" After="RestoreBootstrapTokenFile">NOT BOOTSTRAPTOKENFILE</Custom>
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SaveEnrollUrl" Before="AppSearch" />
      <Custom Action="RestoreEnrollUrl" After="AppSearch">CMDLINE_ENROLLURL</Custom>
      <Custom Action="SaveServer" Before="AppSearch" />
      <Custom Action="RestoreServer" After="AppSearch">CMDLINE_SERVER</Custom>
      <Custom Action="SaveServerName" Before="AppSearch" />
      <Custom Action="RestoreServerName" After="AppSearch">CMDLINE_SERVERNAME</Custom>
      <Custom Action="SaveCaBundle" Before="AppSearch" />
      <Custom Action="RestoreCaBundle" After="AppSearch">CMDLINE_CABUNDLE</Custom>
      <Custom Action="SaveBootstrapTokenFile" Before="AppSearch" />
      <Custom Action="RestoreBootstrapTokenFile" After="AppSearch">CMDLINE_BOOTSTRAPTOKENFILE</Custom>
      <Custom Action="DefaultCaBundle" After="RestoreCaBundle">NOT CABUNDLE</Custom>
      <Custom Action="DefaultBootstrapTokenFile" After="RestoreBootstrapTokenFile">NOT BOOTSTRAPTOKENFILE</Custom>
    </InstallExecuteSequence>
    <Condition Message="ENROLLURL is required, for example ENROLLURL=https://cp:8443.">Installed OR ENROLLURL</Condition>
    <Condition Message="SERVER is required, for example SERVER=cp:9443.">Installed OR SERVER</Condition>
    <Condition Message="SERVERNAME is required, for example SERVERNAME=cp.">Installed OR SERVERNAME</Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="trstctl" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AgentSettings" Guid="*">
        <RegistryKey Root="HKLM" Key="Software\trstctl\agent">
          <RegistryValue Name="EnrollUrl" Type="string" Value="[ENROLLURL]" KeyPath="yes" />
          <RegistryValue Name="Server" Type="string" Value="[SERVER]" />
          <RegistryValue Name="ServerName" Type="string" Value="[SERVERNAME]" />
          <RegistryValue Name="CaBundle" Type="string" Value="[CABUNDLE]" />
          <RegistryValue Name="BootstrapTokenFile" Type="string" Value="[BOOTSTRAPTOKENFILE]" />
        </RegistryKey>
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <Component Id="AgentExecutable" Guid="*">
        <File Id="AgentExe" Name="trstctl-agent.exe" Source="trstctl-agent.exe" KeyPath="yes" />
        <ServiceInstall Id="AgentServiceInstall"
                        Name="trstctl-agent"
                        DisplayName="trstctl agent"
                        Description="trstctl non-human identity agent: enrolls with the control plane, maintains mutual TLS, and installs and rotates credentials on this host."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="--service=run --enroll-url [ENROLLURL] --bootstrap-token-file [BOOTSTRAPTOKENFILE] --ca-bundle [CABUNDLE] --server [SERVER] --server-name [SERVERNAME] --name [ComputerName] --key [CommonAppDataFolder]trstctl\agent.key --cert [CommonAppDataFolder]trstctl\agent.crt">
          <ServiceConfig Id="AgentFailureClassification"
                         FailureActionsWhen="failedToStopOrReturnedError"
                         OnInstall="yes"
                         OnReinstall="yes" />
          <!-- The restart actions (30 s, 60 s, then 5 min) are set by the
               agent on its own service whenever it starts. Windows
               Installer's failure-action table opens the service without
               the start right a restart action needs, so the install would
               fail with error 1939. -->
        </ServiceInstall>
        <ServiceControl Id="AgentServiceControl"
                        Name="trstctl-agent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="AgentFeature" Title="trstctl agent" Level="1">
      <ComponentGroupRef Id="AgentComponents" />
      <ComponentRef Id="AgentSettings" />
    </Feature>
  </Product>
</Wix>
