# syntax=docker/dockerfile:1.7

# cgo-enabled agent artifact for PKCS#11 token inventory (A18). It is a
# separate image because the normal image stays static and distroless; the
# PKCS#11 ABI is dlopen, so an agent that inventories HSM and smart-card
# certificate objects needs glibc plus the vendor module on its library path.
# The binary keeps its name and flags: swap the DaemonSet image and add
# --inventory-pkcs11-module (and, for tokens whose certificate objects are not
# public, --inventory-pkcs11-pin-file). The read is metadata only over a
# read-only session; no private key object is searched for or exported.

# Both values are required at the caller and must be repository@sha256:...
# references. The release workflow resolves them before invoking BuildKit; a
# mutable tag can no longer be an implicit input.
ARG BUILD_IMAGE
ARG BASE_IMAGE

FROM ${BUILD_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

# BuildKit supplies these automatic platform args for both a native local build
# and each release buildx target. Defaults would silently cross-compile cgo with
# the wrong host compiler on arm64 builders.
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT=none
ARG DATE=1970-01-01T00:00:00Z
ENV CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} GOFLAGS=-mod=readonly
ARG LDFLAGS="-s -w -buildid= -X trstctl.com/trstctl/internal/buildinfo.version=${VERSION} -X trstctl.com/trstctl/internal/buildinfo.commit=${COMMIT} -X trstctl.com/trstctl/internal/buildinfo.date=${DATE}"
RUN go build -trimpath -buildvcs=false -ldflags "${LDFLAGS}" -o /out/trstctl-agent ./cmd/trstctl-agent

FROM ${BASE_IMAGE}
# Debian snapshot timestamps are immutable. Replacing the image's moving apt
# sources pins the exact package universe used by released images.
# softhsm2 ships libsofthsm2.so (and softhsm2-util for lab tokens);
# opensc-pkcs11 ships opensc-pkcs11.so for smart cards and opensc the
# pkcs11-tool used to inspect a token independently of the agent. Vendor HSM
# modules (libykcs11, cknfast, Cryptoki) are mounted in by the operator.
RUN printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260701T000000Z bookworm main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260701T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates softhsm2 opensc opensc-pkcs11 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 65532 nonroot \
 && useradd --system --uid 65532 --gid 65532 --home-dir /nonexistent --shell /usr/sbin/nologin nonroot \
 && install -d -m 0700 -o 65532 -g 65532 /var/lib/trstctl-agent /var/run/trstctl

COPY --from=build /out/trstctl-agent /usr/local/bin/trstctl-agent
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/trstctl-agent"]
