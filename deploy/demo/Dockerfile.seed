# syntax=docker/dockerfile:1.7

ARG GO_VERSION=1.26.5
ARG BUILD_IMAGE=golang:${GO_VERSION}-bookworm
ARG WEB_BUILD_IMAGE=node:22-bookworm-slim

FROM ${WEB_BUILD_IMAGE} AS web-build
WORKDIR /src
COPY web/package.json web/package-lock.json ./web/
RUN npm --prefix web ci
COPY web/ ./web/
COPY internal/api/testdata/openapi.golden.json ./internal/api/testdata/openapi.golden.json
RUN npm --prefix web run build

FROM ${BUILD_IMAGE} AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=web-build /src/internal/webui/dist ./internal/webui/dist
RUN CGO_ENABLED=0 GOFLAGS=-mod=readonly go build -trimpath -buildvcs=false -ldflags "-s -w -buildid=" -o /out/trstctl ./cmd/trstctl

# Digest-pinned, not a floating tag, so the seeded demo image is reproducible
# (SUPPLY-008; enforced by scripts/ci/check-compose-images-pinned.sh).
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4
RUN apk add --no-cache ca-certificates openssl
COPY --from=build /out/trstctl /usr/local/bin/trstctl
COPY deploy/demo/seed.mjs /demo/seed.mjs
ENTRYPOINT ["node", "/demo/seed.mjs"]
