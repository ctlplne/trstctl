  "info": {
    "description": "Proof-Carrying Algorithm Succession external surface (ee/, LicenseRef-trstctl-EE).",
    "title": "trstctl PCAS API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/pcas/acks": {
      "post": {
        "operationId": "recordRPAck",
        "parameters": [
          {
            "description": "AN-5 idempotency key; replaying it returns the original result",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PCASAckRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "success"
          }
        },
        "summary": "Record a signed relying-party post-quantum capability acknowledgment"
      }
    },
    "/api/v1/pcas/chain": {
      "get": {
        "operationId": "getSuccessionChain",
        "parameters": [
          {
            "description": "stable identity identifier",
            "in": "query",
            "name": "identity_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success"
          }
        },
        "summary": "Fetch an identity's succession chain for offline relying-party verification"
      }
    },
    "/api/v1/pcas/checkpoints": {
      "get": {
        "operationId": "getPCASCheckpoint",
        "parameters": [
          {
            "description": "stable identity identifier",
            "in": "query",
            "name": "identity_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success"
          }
        },
        "summary": "Fetch the latest signed PCAS epoch checkpoint for an identity"
      }
    },
