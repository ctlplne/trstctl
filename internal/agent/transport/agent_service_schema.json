{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "codec": {
    "content_subtype": "agent.json",
    "name": "agent.json"
  },
  "contract": "trstctl.agent.v1.AgentService",
  "messages": {
    "ClaimJobsRequest": {
      "fields": [
        {
          "go_type": "[]string",
          "name": "kinds",
          "presence": "optional"
        },
        {
          "go_type": "int",
          "name": "limit",
          "presence": "optional"
        },
        {
          "go_type": "int",
          "name": "lease_seconds",
          "presence": "optional"
        }
      ]
    },
    "ClaimJobsResponse": {
      "fields": [
        {
          "go_type": "[]transport.ClaimedJob",
          "name": "jobs",
          "presence": "optional"
        },
        {
          "go_type": "int",
          "name": "next_poll_seconds",
          "presence": "optional"
        }
      ]
    },
    "ClaimedJob": {
      "fields": [
        {
          "go_type": "int64",
          "name": "job_id",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "kind",
          "presence": "required"
        },
        {
          "go_type": "bytes_base64",
          "name": "payload",
          "presence": "optional"
        },
        {
          "go_type": "string",
          "name": "idempotency_key",
          "presence": "optional"
        },
        {
          "go_type": "int64",
          "name": "lease_expires_unix",
          "presence": "optional"
        },
        {
          "go_type": "int",
          "name": "attempt",
          "presence": "optional"
        }
      ]
    },
    "HeartbeatRequest": {
      "fields": [
        {
          "go_type": "string",
          "name": "agent_id",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "version",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "status",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "cert_serial",
          "presence": "optional"
        },
        {
          "go_type": "map\u003cstring,int64\u003e",
          "name": "inventory",
          "presence": "optional"
        }
      ]
    },
    "HeartbeatResponse": {
      "fields": [
        {
          "go_type": "string",
          "name": "tenant_id",
          "presence": "required"
        },
        {
          "go_type": "int64",
          "name": "next_heartbeat_seconds",
          "presence": "required"
        }
      ]
    },
    "InventoryFinding": {
      "fields": [
        {
          "go_type": "string",
          "name": "kind",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "ref",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "provenance",
          "presence": "optional"
        },
        {
          "go_type": "string",
          "name": "fingerprint",
          "presence": "optional"
        },
        {
          "go_type": "int",
          "name": "risk_score",
          "presence": "optional"
        },
        {
          "go_type": "map\u003cstring,string\u003e",
          "name": "metadata",
          "presence": "optional"
        }
      ]
    },
    "InventoryRequest": {
      "fields": [
        {
          "go_type": "string",
          "name": "source_kind",
          "presence": "required"
        },
        {
          "go_type": "[]InventoryFinding",
          "name": "findings",
          "presence": "required"
        }
      ]
    },
    "InventoryResponse": {
      "fields": [
        {
          "go_type": "string",
          "name": "tenant_id",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "run_id",
          "presence": "required"
        },
        {
          "go_type": "int",
          "name": "recorded",
          "presence": "required"
        },
        {
          "go_type": "int",
          "name": "rejected",
          "presence": "required"
        }
      ]
    },
    "KubernetesPostureRequest": {
      "fields": [
        {
          "go_type": "string",
          "name": "report_id",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "cluster_id",
          "presence": "required"
        },
        {
          "go_type": "int",
          "name": "reconcile_interval_seconds",
          "presence": "required"
        },
        {
          "go_type": "transport.KubernetesPostureSection",
          "name": "certificate_signing_requests",
          "presence": "required"
        },
        {
          "go_type": "transport.KubernetesPostureSection",
          "name": "trust_bundles",
          "presence": "required"
        }
      ]
    },
    "KubernetesPostureResource": {
      "fields": [
        {
          "go_type": "string",
          "name": "namespace",
          "presence": "optional"
        },
        {
          "go_type": "string",
          "name": "name",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "uid",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "resource_version",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "state",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "reason",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "public_hash",
          "presence": "optional"
        }
      ]
    },
    "KubernetesPostureResponse": {
      "fields": [
        {
          "go_type": "string",
          "name": "tenant_id",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "report_id",
          "presence": "required"
        },
        {
          "go_type": "int64",
          "name": "recorded_at_unix",
          "presence": "required"
        }
      ]
    },
    "KubernetesPostureSection": {
      "fields": [
        {
          "go_type": "bool",
          "name": "complete",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "failure_code",
          "presence": "optional"
        },
        {
          "go_type": "[]KubernetesPostureResource",
          "name": "resources",
          "presence": "required"
        }
      ]
    },
    "RenewRequest": {
      "fields": [
        {
          "go_type": "bytes_base64",
          "name": "csr_der",
          "presence": "required"
        }
      ]
    },
    "RenewResponse": {
      "fields": [
        {
          "go_type": "bytes_base64",
          "name": "cert_chain_pem",
          "presence": "required"
        },
        {
          "go_type": "int64",
          "name": "not_after_unix",
          "presence": "required"
        }
      ]
    },
    "ReportJobResultRequest": {
      "fields": [
        {
          "go_type": "int64",
          "name": "job_id",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "outcome",
          "presence": "required"
        },
        {
          "go_type": "string",
          "name": "detail",
          "presence": "optional"
        },
        {
          "go_type": "string",
          "name": "evidence_digest",
          "presence": "optional"
        },
        {
          "go_type": "int",
          "name": "lease_seconds",
          "presence": "optional"
        }
      ]
    },
    "ReportJobResultResponse": {
      "fields": [
        {
          "go_type": "bool",
          "name": "accepted",
          "presence": "required"
        },
        {
          "go_type": "int64",
          "name": "lease_expires_unix",
          "presence": "optional"
        }
      ]
    }
  },
  "metadata": {
    "agent_capabilities_key": "x-trstctl-agent-capabilities",
    "agent_protocol_key": "x-trstctl-agent-protocol",
    "agent_version_key": "x-trstctl-agent-version",
    "capabilities": [
      "heartbeat",
      "renew",
      "inventory",
      "kubernetes-posture",
      "jobs"
    ],
    "server_capabilities_key": "x-trstctl-server-capabilities",
    "server_protocol_key": "x-trstctl-server-protocol"
  },
  "service": {
    "metadata": "trstctl.agent.v1",
    "methods": [
      {
        "full_method": "/trstctl.agent.v1.AgentService/Heartbeat",
        "name": "Heartbeat",
        "request": "HeartbeatRequest",
        "response": "HeartbeatResponse"
      },
      {
        "full_method": "/trstctl.agent.v1.AgentService/Renew",
        "name": "Renew",
        "request": "RenewRequest",
        "response": "RenewResponse"
      },
      {
        "full_method": "/trstctl.agent.v1.AgentService/ReportInventory",
        "name": "ReportInventory",
        "request": "InventoryRequest",
        "response": "InventoryResponse"
      },
      {
        "full_method": "/trstctl.agent.v1.AgentService/ReportKubernetesPosture",
        "name": "ReportKubernetesPosture",
        "request": "KubernetesPostureRequest",
        "response": "KubernetesPostureResponse"
      },
      {
        "full_method": "/trstctl.agent.v1.AgentService/ClaimJobs",
        "name": "ClaimJobs",
        "request": "ClaimJobsRequest",
        "response": "ClaimJobsResponse"
      },
      {
        "full_method": "/trstctl.agent.v1.AgentService/ReportJobResult",
        "name": "ReportJobResult",
        "request": "ReportJobResultRequest",
        "response": "ReportJobResultResponse"
      }
    ],
    "name": "trstctl.agent.v1.AgentService"
  }
}
