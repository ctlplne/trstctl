# Expected digests for every external container base image the release builds on.
#
# Why this file exists (SUPPLY-001):
#
# release.yml used to resolve each base from a FLOATING tag at release time --
# `docker buildx imagetools inspect node:22-bookworm-slim` -- and validate only
# that the answer looked like a digest (`=~ ^sha256:[0-9a-f]{64}$`). That checks
# the shape, not the identity. If the upstream tag is repointed, or the registry
# account is compromised, between one release and the next, the release silently
# builds on a different image and every attestation faithfully attests the wrong
# thing. The step's own comment claimed it stopped exactly that.
#
# Real pinning means the digest is committed here, reviewed like any other change,
# and compared at release time. A base image moving then becomes a pull request,
# which is what it should have been all along.
#
# TO ADD OR UPDATE A PIN
#
#   1. Run the release workflow (or `docker buildx imagetools inspect <ref>
#      --format '{{.Manifest.Digest}}'` locally).
#   2. When a pin is missing or stale the build FAILS and prints the digest it
#      resolved, with the exact line to paste here.
#   3. Verify that digest is the image you expect -- check the upstream release
#      notes, not just that the build went green -- then commit the change.
#
# A Go toolchain bump changes the GOLANG_* key, so it deliberately requires a new
# pin: upgrading Go is also a decision to build on a new base image.
#
# Format: KEY=sha256:<64 hex>. Blank lines and # comments are ignored.

# Web builder base (node:22-bookworm-slim)
NODE_22_BOOKWORM_SLIM=sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

# Go builder base (golang:<toolchain>-bookworm); key includes the toolchain
# version with dots replaced by underscores, e.g. GOLANG_1_26_0_BOOKWORM.
GOLANG_1_26_5_BOOKWORM=sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd

# Runtime base for the distroless control-plane image
# (gcr.io/distroless/static-debian12:nonroot)
DISTROLESS_STATIC_DEBIAN12_NONROOT=sha256:1b7b9f0f0e0a1d2155f531db587cc48ec26aaf97ab64364225f5bf18a054e66a

# Runtime base for the cgo/HSM signer image (debian:bookworm-slim)
DEBIAN_BOOKWORM_SLIM=sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
