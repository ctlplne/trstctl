# syntax=docker/dockerfile:1.7

# Hermetic Linux executor for every shipped-profile DoD runtime test. Native
# Linux and cross-host runs use these same bytes. The caller must pass a
# golang@sha256:... base; no mutable fallback is accepted.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# The snapshot pins the complete package universe. docker.io supplies only the
# client here; the runner talks to the explicitly mounted host Docker socket.
RUN printf '%s\n' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260701T000000Z bookworm main' \
      'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260701T000000Z bookworm-security main' \
      > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates docker.io git openssl python3 curl build-essential perl \
 && rm -rf /var/lib/apt/lists/*

# The real-cluster posture proof runs the reviewed kind release, not an ambient
# host binary. GitHub publishes this digest on the immutable v0.31.0 release.
ARG KIND_VERSION=v0.31.0
ARG KIND_LINUX_AMD64_SHA256=eb244cbafcc157dff60cf68693c14c9a75c4e6e6fedaf9cd71c58117cb93e3fa
RUN curl --fail --silent --show-error --location \
      "https://github.com/kubernetes-sigs/kind/releases/download/${KIND_VERSION}/kind-linux-amd64" \
      --output /usr/local/bin/kind \
 && echo "${KIND_LINUX_AMD64_SHA256}  /usr/local/bin/kind" | sha256sum --check --strict \
 && chmod 0555 /usr/local/bin/kind

# Debian bookworm's stock client predates standardized ML-DSA. Build the current
# OpenSSL 3.5 LTS security release from its official, digest-pinned source so the
# PQC proof is driven by a genuinely independent stock client.
ARG OPENSSL_VERSION=3.5.7
ARG OPENSSL_SOURCE_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8
RUN curl --fail --silent --show-error --location \
      "https://github.com/openssl/openssl/releases/download/openssl-${OPENSSL_VERSION}/openssl-${OPENSSL_VERSION}.tar.gz" \
      --output /tmp/openssl.tar.gz \
 && echo "${OPENSSL_SOURCE_SHA256}  /tmp/openssl.tar.gz" | sha256sum --check --strict \
 && mkdir /tmp/openssl-src \
 && tar --extract --gzip --file /tmp/openssl.tar.gz --directory /tmp/openssl-src --strip-components=1 \
 && cd /tmp/openssl-src \
 && ./Configure linux-x86_64 no-shared no-tests --prefix=/opt/openssl-${OPENSSL_VERSION} \
 && make -j2 \
 && make install_sw \
 && ln -s "/opt/openssl-${OPENSSL_VERSION}/bin/openssl" /usr/local/bin/openssl \
 && /usr/local/bin/openssl version \
 && /usr/local/bin/openssl list -signature-algorithms | grep -F ML-DSA-65 \
 && rm -rf /tmp/openssl-src /tmp/openssl.tar.gz
ENV OPENSSL_CONF=/dev/null

# Cache only modules whose checksums are committed in the runner identity. The
# runtime UID may read this cache but cannot replace already-verified source and
# trick a fresh Go build into compiling bytes that differ from go.sum.
COPY go.mod go.sum /runtime-modules/
RUN cd /runtime-modules \
 && GOFLAGS=-mod=readonly go mod download all \
 && chown -R 0:0 /go \
 && chmod -R a-w /go

RUN groupadd --system --gid 65532 nonroot \
 && useradd --system --uid 65532 --gid 65532 --home-dir /home/nonroot --create-home --shell /usr/sbin/nologin nonroot \
 && chown -R 65532:65532 /home/nonroot

USER 65532:65532
ENV HOME=/home/nonroot
ENTRYPOINT ["/usr/local/go/bin/go"]
