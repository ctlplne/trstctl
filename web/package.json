{
  "name": "trstctl-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "trstctl web UI (F12): React + Vite + Tailwind + shadcn-style shell, dashboards, and OIDC login.",
  "engines": {
    "node": ">=22 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "node scripts/gen-api-types.mjs",
    "i18n:check": "node --test scripts/extract-i18n-messages.test.mjs && node scripts/extract-i18n-messages.mjs --check",
    "i18n:extract": "node scripts/extract-i18n-messages.mjs",
    "build": "npm run gen:api -- --check && tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "size-limit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir=.storybook-static",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource-variable/syne": "^5.2.7",
    "@fontsource/dm-mono": "^5.2.7",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.82.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.4",
    "size-limit": "^12.1.0",
    "storybook": "^10.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "size-limit": [
    {
      "name": "entry chunk (shell + vendor + en catalog, gzip)",
      "path": "../internal/webui/dist/assets/index-*.js",
      "limit": "185 kB"
    },
    {
      "name": "largest page chunk (gzip)",
      "path": "../internal/webui/dist/assets/Secrets-*.js",
      "limit": "30 kB"
    },
    {
      "name": "all JS shipped (gzip)",
      "path": "../internal/webui/dist/assets/*.js",
      "limit": "620 kB"
    }
  ]
}
