{
  "name": "trstctl-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "trstctl web UI (F12): React + Vite + Tailwind + shadcn-style shell, dashboards, and OIDC login.",
  "engines": {
    "node": ">=22 <27",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:feature-contracts": "node scripts/gen-feature-contracts.mjs",
    "gen:i18n-runtime": "node scripts/gen-i18n-runtime-catalogs.mjs",
    "i18n:check": "node --test scripts/extract-i18n-messages.test.mjs && node scripts/extract-i18n-messages.mjs --check && node scripts/check-unused-source-messages.mjs && npm run gen:i18n-runtime -- --check",
    "i18n:extract": "node scripts/extract-i18n-messages.mjs",
    "build": "npm run gen:api -- --check && npm run gen:feature-contracts -- --check && npm run gen:i18n-runtime -- --check && tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "node --test scripts/check-entry-size.test.mjs && size-limit && node scripts/check-entry-size.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir=.storybook-static",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@fontsource-variable/sora": "5.2.8",
    "@fontsource-variable/syne": "5.2.7",
    "@fontsource/dm-mono": "5.2.7",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.82.0",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "2.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@size-limit/file": "12.1.0",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/react-vite": "10.5.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.29",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.23",
    "prettier": "3.8.4",
    "size-limit": "12.1.0",
    "storybook": "10.5.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  },
  "size-limit": [
    {
      "name": "entry chunk only (Brotli; complete graph checked separately)",
      "path": "../internal/webui/dist/assets/index-*.js",
      "limit": "240 kB"
    },
    {
      "name": "largest page chunk (Brotli)",
      "path": "../internal/webui/dist/assets/Secrets-*.js",
      "limit": "30 kB"
    },
    {
      "name": "all JS shipped (Brotli)",
      "path": "../internal/webui/dist/assets/*.js",
      "limit": "700 kB"
    }
  ]
}
