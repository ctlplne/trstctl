# Keep the image build context small, deterministic, and free of local-only
# material. Both shipped Dockerfiles use COPY . ., so this file is the security
# boundary for every build stage, including remote builders.

.git
.github
.gitignore
.dockerignore
.agents/
.codex/
.ruff_cache/
.site/
.vite/
docs-internal/

# The documentation site and its test suite are release inputs, not runtime
# image inputs. The web feature-contract build validates only the four docs
# files cited directly by executable stage evidence, so retain those exact
# witnesses and keep the remaining site out of every COPY . . layer.
docs/**
!docs/coverage_test.go
!docs/features/
!docs/features/acme-and-dns.md
!docs/features/code-signing-and-timestamping.md
!docs/features/secrets.md

# Repository-local audit, dependency, compiler, and release caches.
.sandbox-build/
.supply-chain/
.cache/
.tmp/
tmp/
**/.cache/
**/.tmp/
**/tmp/
**/.fuse_hidden*
**/.DS_Store

# Build and generated outputs. The Dockerfile rebuilds the web console before
# compiling Go, so no worktree-generated web bundle is accepted.
bin/
dist/
tools/bin/
internal/webui/dist/
web/coverage/
web/test-results/
web/playwright-report/
web/.storybook-static/
sbom*.json
wiring-census.json
*.out
*.test
coverage*
cover.out*
/trstctl
/trstctl-agent
/trstctl-signer
/trstctl-operator
**/*.go.[0-9]*
**/*.go.stale*
**/*.go.old*
**/*.stale
**/*.stale.*

# Dependency/vendor caches.
/node_modules/
web/node_modules/
**/node_modules/
vendor/

# Secret-bearing local formats are never valid Docker source inputs. Test
# fixtures required by Go tests are not compiled into these production images.
.env
.env.*
**/.env
**/.env.*
*.key
*.pem
*.p12
*.pfx
*.jks
*.secret
*.secrets

# Editor cruft.
.idea/
.vscode/
*.swp
*~
