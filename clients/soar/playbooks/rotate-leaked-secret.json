{
  "id": "rotate-leaked-secret",
  "title": "Rotate a leaked stored secret and resolve its finding",
  "description": "Writes a new value for a secret trstctl stores, then resolves the leaked-secret finding as remediated with the rotation as evidence. The SOAR supplies the new value (from the system that owns the credential); trstctl never returns it.",
  "inputs": {
    "secret_name": {"type": "string", "required": true},
    "new_value": {"type": "string", "required": true, "secret": true},
    "finding_id": {"type": "string", "required": true, "description": "the leaked_secret discovery finding"},
    "ticket": {"type": "string", "required": true, "description": "the incident or change reference"}
  },
  "steps": [
    {
      "name": "rotate",
      "operation_id": "rotateSecret",
      "method": "PUT",
      "path": "/api/v1/secrets/store/{{secret_name}}",
      "idempotency_key": "soar-rotate-{{secret_name}}-{{ticket}}",
      "body": {"value": "{{new_value}}"},
      "expect": [200],
      "outputs": {"version": "/version"}
    },
    {
      "name": "resolve",
      "operation_id": "resolveDiscoveryFinding",
      "method": "POST",
      "path": "/api/v1/discovery/findings/{{finding_id}}/resolution",
      "idempotency_key": "soar-resolve-{{finding_id}}-{{ticket}}",
      "body": {"action": "remediated", "reason": "rotated by {{ticket}}", "evidence_ref": "secret:{{secret_name}}@{{steps.rotate.version}}"},
      "expect": [200]
    }
  ]
}
